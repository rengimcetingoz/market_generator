from math import inf

def best_k_round_trips(prices, k):
    """
    Maximize profit with at most k transactions (1 transaction = buy then sell).
    Returns (max_profit, trades) where trades is a list of (buy_idx, sell_idx).
    
    Assumptions:
      - prices is a list/array of length n >= 0
      - you cannot hold multiple positions at once
      - you must buy before you sell
      - no shorting
    """
    n = len(prices)
    if k <= 0 or n <= 1:
        return 0, []

    # If k is large, it's equivalent to unlimited transactions: take every up-move.
    if k >= n // 2:
        trades = []
        i = 0
        while i < n-1:
            # find next local valley to buy
            while i < n-1 and prices[i+1] <= prices[i]:
                i += 1
            buy = i
            # find next local peak to sell
            while i < n-1 and prices[i+1] >= prices[i]:
                i += 1
            sell = i
            if sell > buy:
                trades.append((buy, sell))
            i += 1
        profit = sum(prices[s] - prices[b] for b, s in trades)
        # Trim to at most k best segments if needed (rare when k >= n//2, but keep safe)
        if len(trades) > k:
            # Keep the k highest-profit segments
            trades.sort(key=lambda bs: prices[bs[1]] - prices[bs[0]], reverse=True)
            trades = trades[:k]
        profit = sum(prices[s] - prices[b] for b, s in trades)
        trades.sort()  # chronological
        return profit, trades

    # DP for general k: 
    # hold[t][i]: max profit at day i holding a stock after completing t sells
    # cash[t][i]: max profit at day i holding cash after completing t sells
    # We’ll also keep booleans to reconstruct buy/sell decisions.
    hold = [[-inf]*n for _ in range(k+1)]
    cash = [[-inf]*n for _ in range(k+1)]
    buy_taken  = [[False]*n for _ in range(k+1)]   # we bought at i to get hold[t][i]
    sell_taken = [[False]*n for _ in range(k+1)]   # we sold at i to get cash[t][i]

    # Day 0 initialization
    hold[0][0] = -prices[0]
    cash[0][0] = 0
    for t in range(1, k+1):
        hold[t][0] = -inf
        cash[t][0] = -inf

    # Fill DP
    for i in range(1, n):
        # t = 0 (no sells completed yet) separately
        # hold[0][i] = max(hold[0][i-1], cash[0][i-1] - prices[i])
        if hold[0][i-1] >= cash[0][i-1] - prices[i]:
            hold[0][i] = hold[0][i-1]
        else:
            hold[0][i] = cash[0][i-1] - prices[i]
            buy_taken[0][i] = True
        # cash[0][i] = cash[0][i-1] (can't sell without prior sells)
        cash[0][i] = cash[0][i-1]

        # t >= 1
        for t in range(1, k+1):
            # hold[t][i] = max(hold[t][i-1], cash[t][i-1] - prices[i])
            if hold[t][i-1] >= cash[t][i-1] - prices[i]:
                hold[t][i] = hold[t][i-1]
            else:
                hold[t][i] = cash[t][i-1] - prices[i]
                buy_taken[t][i] = True

            # cash[t][i] = max(cash[t][i-1], hold[t-1][i-1] + prices[i])
            if cash[t][i-1] >= hold[t-1][i-1] + prices[i]:
                cash[t][i] = cash[t][i-1]
            else:
                cash[t][i] = hold[t-1][i-1] + prices[i]
                sell_taken[t][i] = True

    # Best profit is with <= k sells; typically cash[k][n-1]
    best_t = max(range(k+1), key=lambda t: cash[t][n-1])
    max_profit = cash[best_t][n-1]

    # Reconstruct trades by backtracking
    trades = []
    i = n - 1
    t = best_t
    state = 'cash'  # start from cash[t][n-1]

    while i >= 0 and t >= 0:
        if state == 'cash':
            # If staying put yields same value, move left
            if i > 0 and cash[t][i] == cash[t][i-1]:
                i -= 1
            # If we sold here to reach cash[t][i], record sell and move to hold[t-1][i-1]
            elif t > 0 and sell_taken[t][i]:
                sell_i = i
                i -= 1
                t -= 1
                state = 'hold'
            else:
                i -= 1
        else:  # state == 'hold' at (t, i)
            # If we were already holding from previous day
            if i > 0 and hold[t][i] == hold[t][i-1]:
                i -= 1
            # If we bought here to reach hold[t][i], pair with last sell
            elif buy_taken[t][i]:
                buy_i = i
                trades.append((buy_i, sell_i))
                i -= 1
                state = 'cash'  # after pairing buy with previous sell, continue in cash[t][...]
            else:
                i -= 1

    trades.reverse()
    return max_profit, trades


# ---- Example ----
if __name__ == "__main__":
    prices = [3, 2, 6, 5, 0, 3]
    k = 2
    profit, trades = best_k_round_trips(prices, k)
    print("Max profit:", profit)          # -> 7
    print("Trades (buy, sell):", trades)  # -> [(1, 2), (4, 5)] or equivalent optimal
