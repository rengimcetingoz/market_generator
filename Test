def best_long_short_trades_roundtrip(prices, k, fee=0.0):
    """
    Maximize profit with at most k completed round trips (transactions).
    Long & short allowed. Closing a position increments the count.
    Same-day reversals consume 1 transaction (the close), then open opposite side.
    Returns: (profit, trades[list of dicts])
    """
    from math import inf
    n = len(prices)
    if n == 0 or k <= 0:
        return 0.0, []
    p = prices

    # DP for day i: flat[t], hold_long[t], hold_short[t] for t completed round trips so far
    flat = [-float('inf')] * (k + 1)
    hold_long = [-float('inf')] * (k + 1)
    hold_short = [-float('inf')] * (k + 1)

    # backpointers: prev[i][t]['F'/'L'/'S'] = (prev_i, prev_t, prev_state, action)
    prev = [[{'F': None, 'L': None, 'S': None} for _ in range(k+1)] for __ in range(n)]

    # Day 0 init
    flat[0] = 0.0
    prev[0][0]['F'] = (None, None, None, None)
    hold_long[0] = flat[0] - p[0]; prev[0][0]['L'] = (0, 0, 'F', 'open_long')
    hold_short[0] = flat[0] + p[0]; prev[0][0]['S'] = (0, 0, 'F', 'open_short')

    for i in range(1, n):
        new_flat, new_long, new_short = flat[:], hold_long[:], hold_short[:]

        # stay flat
        for t in range(k+1):
            if flat[t] > new_flat[t]:
                new_flat[t] = flat[t]; prev[i][t]['F'] = (i-1, t, 'F', 'stay_flat')

        # close long/short -> flat (consumes 1 transaction)
        for t in range(1, k+1):
            cand = hold_long[t-1] + p[i] - fee
            if cand > new_flat[t]:
                new_flat[t] = cand; prev[i][t]['F'] = (i-1, t-1, 'L', 'close_long')
            cand = hold_short[t-1] - p[i] - fee
            if cand > new_flat[t]:
                new_flat[t] = cand; prev[i][t]['F'] = (i-1, t-1, 'S', 'close_short')

        # stay long / open long from flat
        for t in range(k+1):
            if hold_long[t] > new_long[t]:
                new_long[t] = hold_long[t]; prev[i][t]['L'] = (i-1, t, 'L', 'hold_long')
            cand = flat[t] - p[i]
            if cand > new_long[t]:
                new_long[t] = cand; prev[i][t]['L'] = (i-1, t, 'F', 'open_long')

        # reverse short->long (close counts 1, then open long)
        for t in range(1, k+1):
            cand = hold_short[t-1] - fee - 2*p[i]
            if cand > new_long[t]:
                new_long[t] = cand; prev[i][t]['L'] = (i-1, t-1, 'S', 'reverse_to_long')

        # stay short / open short from flat
        for t in range(k+1):
            if hold_short[t] > new_short[t]:
                new_short[t] = hold_short[t]; prev[i][t]['S'] = (i-1, t, 'S', 'hold_short')
            cand = flat[t] + p[i]
            if cand > new_short[t]:
                new_short[t] = cand; prev[i][t]['S'] = (i-1, t, 'F', 'open_short')

        # reverse long->short
        for t in range(1, k+1):
            cand = hold_long[t-1] - fee + 2*p[i]
            if cand > new_short[t]:
                new_short[t] = cand; prev[i][t]['S'] = (i-1, t-1, 'L', 'reverse_to_short')

        flat, hold_long, hold_short = new_flat, new_long, new_short

    # force-flat at end if capacity remains
    best_profit, end_t, end_state, i = -float('inf'), 0, 'F', n-1
    for t in range(k+1):
        if flat[t] > best_profit: best_profit, end_t, end_state = flat[t], t, 'F'
    for t in range(k):
        cand = hold_long[t] + p[-1] - fee
        if cand > best_profit:
            best_profit, end_t, end_state = cand, t+1, 'F'
            prev[i][t+1]['F'] = (i, t, 'L', 'force_close_long')
        cand = hold_short[t] - p[-1] - fee
        if cand > best_profit:
            best_profit, end_t, end_state = cand, t+1, 'F'
            prev[i][t+1]['F'] = (i, t, 'S', 'force_close_short')

    # reconstruct path
    path, cur, seen = [], (n-1, end_t, end_state), set()
    while cur and cur not in seen:
        seen.add(cur); path.append(cur)
        ii, tt, ss = cur
        bp = prev[ii][tt][ss]
        if not bp or bp[0] is None: break
        cur = (bp[0], bp[1], bp[2])
    path.reverse()

    # extract trades
    trades, pos, entry_idx = [], 'F', None
    def act(node):
        ii, tt, ss = node
        bp = prev[ii][tt][ss]
        return None if not bp else bp[3]

    for a, b in zip(path, path[1:]):
        action = act(b); idx = b[0]
        if action == 'open_long' and pos == 'F':
            pos, entry_idx = 'L', idx
        elif action in ('close_long','force_close_long') and pos == 'L' and entry_idx is not None:
            trades.append({'dir':'LONG','entry':entry_idx,'exit':idx,
                           'p_entry':p[entry_idx],'p_exit':p[idx],'pnl':p[idx]-p[entry_idx]-fee})
            pos, entry_idx = 'F', None
        elif action == 'open_short' and pos == 'F':
            pos, entry_idx = 'S', idx
        elif action in ('close_short','force_close_short') and pos == 'S' and entry_idx is not None:
            trades.append({'dir':'SHORT','entry':entry_idx,'exit':idx,
                           'p_entry':p[entry_idx],'p_exit':p[idx],'pnl':p[entry_idx]-p[idx]-fee})
            pos, entry_idx = 'F', None
        elif action == 'reverse_to_long':
            if pos == 'S' and entry_idx is not None:
                trades.append({'dir':'SHORT','entry':entry_idx,'exit':idx,
                               'p_entry':p[entry_idx],'p_exit':p[idx],'pnl':p[entry_idx]-p[idx]-fee})
            pos, entry_idx = 'L', idx
        elif action == 'reverse_to_short':
            if pos == 'L' and entry_idx is not None:
                trades.append({'dir':'LONG','entry':entry_idx,'exit':idx,
                               'p_entry':p[entry_idx],'p_exit':p[idx],'pnl':p[idx]-p[entry_idx]-fee})
            pos, entry_idx = 'S', idx

    if len(trades) > k:
        trades = trades[:k]

    return float(best_profit), trades

def run_case(name, prices, k, fee=0.0):
    profit, trades = best_long_short_trades_roundtrip(prices, k, fee)
    df = pd.DataFrame(trades)
    df['case'] = name; df['k'] = k; df['fee'] = fee
    return profit, df

